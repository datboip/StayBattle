# StayBattle has no required environment variables.
# Everything below is optional.

# Comma-separated list of extra hosts allowed to hit the dev server's
# Next.js internals (HMR, RSC). Private 192.168/10/172.16 ranges are already
# wildcarded, so this is only needed for unusual setups (custom domains,
# public IPs, etc.).
# NEXT_ALLOWED_DEV_ORIGINS=staybattle.local,foo.example.com

# Set to "true" ONLY when serving over https behind a TLS terminator
# (nginx/Caddy/Cloudflare). Adds `upgrade-insecure-requests` + HSTS to the
# response headers and marks the sign-in cookie Secure. Read at BUILD time (next.config headers are baked into the
# build), so pass it to `npm run build` or as a Docker build arg:
#   docker compose build --build-arg STAYBATTLE_HTTPS=true
# Leave unset for plain-http LAN use — otherwise browsers rewrite every asset
# URL to https:// and the page never leaves "Loading…".
# STAYBATTLE_HTTPS=true
