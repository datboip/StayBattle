# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem
*.pfx
*.key

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (NEVER commit real .env values)
.env
.env.local
.env.*.local
.env.development
.env.production
# (we *do* commit .env.example as a template)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / OS
.vscode/
.idea/
*.swp
*~

# local sqlite db (contains everyone's votes, comments, listings — DO NOT COMMIT)
/data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal

# screenshots taken from the live app may contain real listings / names
docs/screenshots/local-*.png
docs/screenshots/private-*.png
/data-demo
/.private-notes-*.md

# brand / design audit artifacts — local-only, never push
/.brand-audit-backup-*/
/public/audit/
*.backup
